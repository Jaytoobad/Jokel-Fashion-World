# Server-side only (used by Vercel Functions /api/enquiry and /api/application)
# Never expose this in the browser. Add it in Vercel → Settings → Environment Variables.
DATABASE_URL=

# Rate limiting: random string for hashing IPs (e.g., run: openssl rand -hex 32)
RATE_LIMIT_SALT=

# Admin access: comma-separated list of staff emails allowed to access /admin
ADMIN_EMAILS=

# Clerk (see docs/ADMIN.md for setup)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=